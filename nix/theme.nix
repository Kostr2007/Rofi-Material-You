# Builds the theme file used by the home-manager module: one of the shipped
# Material You layouts, the palette and the user's settings on top.
{ lib, writeText }:

{ package
, layout ? "list"
, mode ? "dark"
, palette ? null
, font ? null
, width ? null
, animations ? { }
, extraConfig ? { }
, extraTheme ? ""
}:

let
  base = {
    list = { dark = "material-you"; light = "material-you-light"; };
    grid = { dark = "material-you-grid"; light = "material-you-grid-light"; };
  }.${layout}.${mode};

  toRasi = value:
    if builtins.isBool value then (if value then "true" else "false")
    else if builtins.isInt value then toString value
    else if builtins.isFloat value then toString value
    else ''"${lib.escape [ ''"'' ''\'' ] (toString value)}"'';

  configuration = {
    animations = animations.enable or true;
    motion-scheme = animations.motionScheme or "expressive";
    animation-speed = toString (animations.speed or 1.0);
    animation-fps = animations.fps or 120;
  } // extraConfig;
in
writeText "rofi-material-you-${base}.rasi" ''
  /* Generated by the rofi-material-you home-manager module. */
  @import "${package}/share/rofi/themes/${base}.rasi"
  ${lib.optionalString (palette != null) ''@import "${palette}"''}

  configuration {
  ${lib.concatStrings (lib.mapAttrsToList (k: v: "    ${k}: ${toRasi v};\n") configuration)}}
  ${lib.optionalString (font != null) ''
  * {
      font: "${font}";
      font-title: "${font}";
  }
  ''}${lib.optionalString (width != null) ''
  window {
      width: ${width};
  }
  ''}
  ${extraTheme}
''
